# 1. Namespaces & Cgroups (Docker / LXC / Droidspaces)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# 2. File Systems
CONFIG_OVERLAY_FS=y

# 3. Virtual Networking & Bridge
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# 4. USB-to-LAN Drivers
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y

# 5. KernelSU-Next & SuSFS (Chạy chuẩn Manual Hook)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y

# 6. BAT LAI MODVERSIONS DE LOAD DUOC DRIVER /VENDOR
CONFIG_MODVERSIONS=y

# 7. VÔ HIỆU HÓA HOÀN TOÀN TOÀN BỘ 7 LỚP BẢO MẬT SAMSUNG KNOX THEO GORHANHEE
# CONFIG_UH is not set
# CONFIG_UH_RKP is not set
# CONFIG_UH_LKM is not set
# CONFIG_RKP is not set
# CONFIG_RKP_KDP is not set
# CONFIG_RKP_DMAP_PROT is not set
# CONFIG_RKP_CFP is not set
# CONFIG_RKP_CFP_JOPP is not set
# CONFIG_RKP_CFP_ROPP is not set
# CONFIG_KDP is not set
# CONFIG_KDP_NS is not set
# CONFIG_CFP is not set
# CONFIG_CFP_ROPP is not set
# CONFIG_CFP_JOPP is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_DEFEX is not set
# CONFIG_PROCA is not set
# CONFIG_FIVE is not set
# CONFIG_FIVE_PA_FEATURE is not set
# CONFIG_FIVE_USE_RPMB is not set
# CONFIG_SECURITY_DSMS is not set
# CONFIG_SEC_RESTRICT_ROOTING is not set
# CONFIG_SEC_RESTRICT_SETUID is not set
# CONFIG_TIMA is not set
# CONFIG_KNOX_KAP is not set
# CONFIG_SEC_EXT is not set
# CONFIG_INTEGRITY is not set
